#!/usr/bin/env bash
# Pre-push gate: the broker-free test suite over both crates we own.
#
# This is `make test` -- the same thing CI's `test` job runs. It takes minutes, which is why it
# is here and not in pre-commit: a push is the point where being wrong costs a ~30-minute CI
# round trip (and, on vk-cloud, a staging deploy).
#
# Enable once per clone (shared with pre-commit):
#
#     git config core.hooksPath .githooks
#
# NOT covered here, by design:
#   - `make test-integration` needs Docker (Kafka + MinIO); run it when touching the transport.
#   - `#[ignore]`d wall-clock tests; run with `-- --ignored` and JAGUA_PERF_ASSERTS=1.
#
# Escape hatch: `git push --no-verify`.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

export PATH="$HOME/.cargo/bin:$PATH"

if [[ -n "${SKIP_PREPUSH_TESTS:-}" ]]; then
  echo "pre-push: SKIP_PREPUSH_TESTS set, skipping tests"
  exit 0
fi

command -v cargo >/dev/null 2>&1 || { echo "pre-push: cargo not found on PATH" >&2; exit 1; }

echo "pre-push: cargo test -p jagua-utils -p jagua-sqs-processor (this takes a few minutes)"
if ! cargo test -p jagua-utils -p jagua-sqs-processor; then
  echo "" >&2
  echo "pre-push: tests failed -- this is what CI would have told you in ~30 minutes." >&2
  echo "pre-push: bypass with 'git push --no-verify' only if you know why it is failing." >&2
  exit 1
fi

echo "pre-push: ok"
